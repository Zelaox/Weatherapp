{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "heatmap_spatial_index_rules",
  "type": "object",
  "required": ["schema_version", "priority_order", "evaluation_order", "first_match_wins", "rules"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "priority_order": { "type": "string", "enum": ["asc", "desc"] },
    "evaluation_order": { "type": "string", "enum": ["top_down"] },
    "first_match_wins": { "type": "boolean" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_priority", "when", "then"],
        "properties": {
          "rule_priority": { "type": "integer" },
          "when": { "type": "object" },
          "then": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": { "type": "string", "enum": ["brute_force", "kd_tree", "grid_bucket"] }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
